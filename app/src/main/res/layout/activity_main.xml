<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="Jarvis"
            android:textColor="@color/ink"
            android:textSize="40sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/inkDim"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/toggle"
                style="@style/Btn.Primary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Start Jarvis" />

            <Button
                android:id="@+id/talk"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Talk now" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/Label" android:text="SETUP" />

            <TextView style="@style/Hint" android:text="Claude API key (from platform.claude.com)" />
            <EditText android:id="@+id/claudeKey" style="@style/Field" android:inputType="textPassword" android:hint="sk-ant-..." />

            <EditText android:id="@+id/picoKey" style="@style/Field" android:inputType="textPassword" android:visibility="gone" />

            <TextView style="@style/Hint" android:text="Google voice key (optional, for the realistic voice)" />
            <EditText android:id="@+id/ttsKey" style="@style/Field" android:inputType="textPassword" android:hint="AIza..." />

            <TextView style="@style/Hint" android:text="Voice name (optional)" />
            <EditText android:id="@+id/voiceName" style="@style/Field" android:inputType="text" android:hint="en-GB-Chirp3-HD-Charon" />

            <TextView style="@style/Hint" android:text="Your partner's name (optional)" />
            <EditText android:id="@+id/herName" style="@style/Field" android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/Hint" android:text="What Jarvis should know about your day" />
            <EditText android:id="@+id/notes" style="@style/Field" android:hint="Your routine, family, goals, where you live…" android:gravity="top" android:inputType="textMultiLine|textCapSentences" android:minLines="4" />

            <TextView style="@style/Hint" android:text="Your city (for weather)" />
            <EditText android:id="@+id/city" style="@style/Field" android:inputType="textCapWords" android:hint="e.g. Spokane" />

            <TextView style="@style/Hint" android:text="Lunch rush (24-hour, start-end)" />
            <EditText android:id="@+id/lunch" style="@style/Field" android:inputType="text" android:hint="11:00-14:00" />

            <TextView style="@style/Hint" android:text="Dinner rush (24-hour, start-end)" />
            <EditText android:id="@+id/dinner" style="@style/Field" android:inputType="text" android:hint="17:00-21:00" />

            <TextView style="@style/Hint" android:text="Your car's Bluetooth name (for driving mode)" />
            <EditText android:id="@+id/carName" style="@style/Field" android:inputType="text" android:hint="e.g. Honda, CAR MULTIMEDIA" />

            <TextView style="@style/Hint" android:text="Bedtime (24-hour)" />
            <EditText android:id="@+id/bedtime" style="@style/Field" android:inputType="text" android:hint="00:00" />

            <Button android:id="@+id/save" style="@style/Btn.Primary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Save" />
            <TextView style="@style/Hint" android:layout_marginTop="10dp" android:text="Your keys stay on this phone only." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/Label" android:text="CONVERSATION" />
            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <Button android:id="@+id/editSetup" style="@style/Btn.Small" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Setup" />
            <Button android:id="@+id/battery" style="@style/Btn.Small" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="Battery" />
            <Button android:id="@+id/clear" style="@style/Btn.Small" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="Clear" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
            <Button android:id="@+id/allowComms" style="@style/Btn.Small" android:layout_width="match_parent" android:layout_height="44dp" android:text="Allow calls &amp; texts" />
            <Button android:id="@+id/allowApps" style="@style/Btn.Small" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Allow opening apps" />
            <Button android:id="@+id/memoryBtn" style="@style/Btn.Small" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="8dp" android:text="What Jarvis remembers" />
            <Button android:id="@+id/testVoice" style="@style/Btn.Small" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="8dp" android:text="Test voice" />
            <Button android:id="@+id/allowMsgs" style="@style/Btn.Small" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="8dp" android:text="Allow reading messages" />
            <Button android:id="@+id/readMode" style="@style/Btn.Small" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="8dp" android:text="Read messages aloud: while driving" />
            <Button android:id="@+id/wakeScreen" style="@style/Btn.Small" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="8dp" android:text="Show replies on lock screen: on" />
            <Button android:id="@+id/talkFirst" style="@style/Btn.Small" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Speaks first: on" />
        </LinearLayout>

        <Button android:id="@+id/update" style="@style/Btn.Small" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
